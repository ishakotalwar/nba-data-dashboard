# Keep the upload — and the 250 MB function bundle — small.
venv/
node_modules/
__pycache__/
*.py[cod]
.DS_Store

# Not used at request time: the ETL runs locally, app.py is the Streamlit
# prototype, docs/ is README imagery. Leading slashes anchor these to the
# repo root — these patterns are gitignore-style and would otherwise match
# at any depth.
/etl/
/app.py
/docs/

# NOTE: requirements.txt must NOT be ignored — Vercel's Python builder installs
# it from the project root, and hiding it shipped the function with no
# dependencies at all. The Streamlit-only extras live in requirements-local.txt,
# which is ignored here instead.
/requirements-local.txt
