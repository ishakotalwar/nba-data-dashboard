# Keep the upload — and the 250 MB function bundle — small.
venv/
node_modules/
__pycache__/
*.py[cod]
.DS_Store

# Not used at request time: the ETL runs locally, app.py is the Streamlit
# prototype, docs/ is README imagery.
etl/
app.py
docs/

# Deployment installs api/requirements.txt. Hiding the root file keeps the
# Streamlit-only deps (streamlit, plotly, duckdb, nba_api) out of the bundle
# no matter which one the builder would otherwise pick up.
requirements.txt
