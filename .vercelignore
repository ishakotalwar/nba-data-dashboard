# Keep the upload — and the 250 MB function bundle — small.
venv/
node_modules/
__pycache__/
*.py[cod]
.DS_Store

# Not used at request time: the ETL runs locally, app.py is the Streamlit
# prototype, docs/ is README imagery. Leading slashes anchor these to the
# repo root — these patterns are gitignore-style and would otherwise match
# at any depth.
/etl/
/app.py
/docs/

# Deployment installs api/requirements.txt. Hiding the ROOT file keeps the
# Streamlit-only deps (streamlit, plotly, duckdb, nba_api) out of the bundle.
# The leading slash is essential: a bare `requirements.txt` would also match
# api/requirements.txt and ship the function with no dependencies at all.
/requirements.txt
